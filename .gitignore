# This repository keeps only the scripts and their input data. Everything the scripts
# write (figures, tables, workbooks, intermediate files) is ignored, because it can be
# regenerated by running the pipeline (see README.md).
#
# How this file works: the first rule ignores everything at the top level, and each
# rule starting with "!" brings a file or folder back in.

/*

# Documentation and repository files
!/.gitignore
!/README.md
!/LAYOUT.md
!/LICENSE
!/CITATION.cff

# All R scripts in the main folder
!/*.R

# Input data in the main folder
!/final_freezing_plan.csv
!/good_strains.csv
!/strains_analysed.csv
!/Table S1.csv
!/20231213_c_elegans_strain_data.csv
!/wild_isolate_variants.csv
!/WI.20231213.hard-filter.isotype.min4.tree
!/SpeciesTree_rooted copy.tree
!/mic_all3data.csv
!/pheno8_percent_males.csv
!/*_RILs_*.csv
!/*_RILs_joint.filtered.tsv
!/JU2610_wild_isolates_canddiategenetest_*.csv
!/m395_wild_isolates_*.csv
!/*_FISH_area.csv
!/*_FISH_body.csv

# BSA: allele depths per population (inputs to BSA_all_populations.R and the
# allele-frequency figures) and the cluster script that made them. The tar.gz
# archives and BSA_exploratory/ (plots) are not included.
!/BSA_results/
/BSA_results/*
!/BSA_results/BSA_all.slurm
!/BSA_results/*/
/BSA_results/*/*
!/BSA_results/*/*_allele_depths.tsv
!/BSA_results/*/*_allele_depths_columns.tsv
!/BSA_results/*/*_samples.txt
!/BSA_results/*/*_versions.txt

# RIL variant calling: cluster scripts and logs, the filtered joint VCF, and the
# VCF-kit hmm output (not the raw or uncompressed VCFs)
!/*_RILs/
/*_RILs/*
!/*_RILs/*.slurm
!/*_RILs/*.out
!/*_RILs/*.err
!/*_RILs/*.filtered.vcf.gz
!/*_RILs/*.filtered.vcf.gz.csi
!/*_RILs/*joint.filtered.tsv
!/*_RILs/*_vk_hmm_commands.sh

# phenoMIP 6.0 MIP results
!/mip_results/

# Upstream (stage 1): scripts only, not their outputs
!/upstream/
/upstream/*
!/upstream/*.R

# Mini-phenoMIP (stage 2): scripts and MIP results only
!/minipheno/
/minipheno/*
!/minipheno/*.R
!/minipheno/mip_results/

# NemaScan outputs (inputs to Supp. Fig. S18), but not the figure PDF
!/gwas/
/gwas/*.pdf

# Optional: uncomment to also include the final figure PDFs
# !/Figure_*_Final.pdf
# !/supp_fig*.pdf

# Never include these, wherever they are
.DS_Store
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
~$*

# Final figure PDFs (copies of the published figures)
!/figures/
!/figures/*.pdf


!/figures/*.png
